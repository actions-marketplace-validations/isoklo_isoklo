{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": true,
    "newLine": "lf",
    "types": ["node"]
  },
  "include": ["src"]
}
