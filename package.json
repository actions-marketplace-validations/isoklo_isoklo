{
  "name": "isoklo",
  "version": "0.1.1",
  "description": "Proof before merge. A merge gate for AI coding agents.",
  "license": "FSL-1.1-ALv2",
  "author": "Manish Guptha",
  "homepage": "https://github.com/isoklo/isoklo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoklo/isoklo.git"
  },
  "bugs": {
    "url": "https://github.com/isoklo/isoklo/issues"
  },
  "type": "module",
  "bin": {
    "isoklo": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-agents",
    "code-review",
    "merge-gate",
    "ci",
    "pull-requests"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
