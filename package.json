{
  "name": "isoklo",
  "version": "0.2.0",
  "description": "Proof before merge. A deterministic merge gate for AI-written pull requests: weakened tests, invented packages, leaked secrets, injected agent instructions, risky MCP servers and out-of-scope edits.",
  "license": "FSL-1.1-ALv2",
  "author": "Manish Guptha",
  "homepage": "https://github.com/isoklo/isoklo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoklo/isoklo.git"
  },
  "bugs": {
    "url": "https://github.com/isoklo/isoklo/issues"
  },
  "type": "module",
  "bin": {
    "isoklo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./schema/isoklo.config.schema.json": "./schema/isoklo.config.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/engine/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "schema",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "test:app": "npm --prefix apps/github-app test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:app",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "ai-agents",
    "code-review",
    "merge-gate",
    "ci",
    "pull-requests",
    "security",
    "mcp",
    "supply-chain",
    "secrets",
    "sarif"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
